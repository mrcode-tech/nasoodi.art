{
  "name": "nasoodi-art",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run images:generate",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsc --resolveJsonModule --module commonjs --target es2022 --moduleResolution node --strict --esModuleInterop --skipLibCheck --outDir .test-build tests/content.test.ts tests/gallery-pagination.test.ts tests/seo.test.ts src/lib/gallery-pagination.ts src/lib/locale-number.ts && node --test .test-build/tests/content.test.js .test-build/tests/gallery-pagination.test.js .test-build/tests/seo.test.js",
    "test:e2e": "playwright test",
    "prebuild": "npm run images:check",
    "audit:i18n": "node scripts/audit-i18n-messages.mjs",
    "audit:content-independence": "node scripts/audit-content-independence.mjs",
    "images:generate": "node scripts/generate-image-metadata.mjs",
    "images:check": "node scripts/generate-image-metadata.mjs --check"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "embla-carousel-react": "^8.6.0",
    "clsx": "^2.1.1",
    "next": "16.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.3.1",
    "next-themes": "^0.4.6",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "next-intl": "4.14.9",
    "@vercel/analytics": "^2.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "tslib": "2.8.1"
  }
}
